{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HTTP client environments (http-client.env.json)",
  "description": "Environments for .http files: { \"<environment>\": { \"<variable>\": \"<value>\" } }. \"$shared\" applies to every environment.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "Security": {
        "type": "object",
        "properties": {
          "Auth": {
            "type": "object",
            "description": "OAuth 2 configurations by id.",
            "additionalProperties": {
              "type": "object",
              "description": "An OAuth 2.0 configuration. Use it in a request as {{$auth.token(\"<this id>\")}} (or $auth.idToken). Plainwire fetches, caches and refreshes the token.",
              "properties": {
                "Type": {
                  "type": "string",
                  "enum": [
                    "OAuth2",
                    "Mock"
                  ],
                  "default": "OAuth2"
                },
                "Grant Type": {
                  "type": "string",
                  "enum": [
                    "Authorization Code",
                    "Client Credentials",
                    "Device Authorization",
                    "Implicit",
                    "Password"
                  ]
                },
                "Auth URL": {
                  "type": "string",
                  "description": "Authorization endpoint (Authorization Code, Implicit)."
                },
                "Token URL": {
                  "type": "string",
                  "description": "Token endpoint (all grants except Implicit)."
                },
                "Redirect URL": {
                  "type": "string",
                  "description": "Must be http://localhost:<port>/\u2026 or http://127.0.0.1:<port>/\u2026; Plainwire listens there for the sign-in. Default: a free port, http://127.0.0.1:<port>/callback."
                },
                "Device Auth URL": {
                  "type": "string",
                  "description": "Device authorization endpoint (Device Authorization)."
                },
                "Client ID": {
                  "type": "string"
                },
                "Client Secret": {
                  "type": "string",
                  "description": "Keep it in http-client.private.env.json (same structure; it is merged into this configuration) or use {{variables}}."
                },
                "Client Credentials": {
                  "type": "string",
                  "enum": [
                    "basic",
                    "in body",
                    "none"
                  ],
                  "default": "basic",
                  "description": "How the client authenticates at the token endpoint."
                },
                "Scope": {
                  "type": "string"
                },
                "Username": {
                  "type": "string",
                  "description": "Password grant."
                },
                "Password": {
                  "type": "string",
                  "description": "Password grant. Use a private variable, e.g. {{password}}."
                },
                "PKCE": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "Code Challenge Method": {
                          "type": "string",
                          "enum": [
                            "SHA-256",
                            "Plain"
                          ]
                        },
                        "Code Verifier": {
                          "type": "string"
                        }
                      }
                    }
                  ],
                  "description": "Authorization Code with PKCE. true = SHA-256 with a generated verifier."
                },
                "Custom Request Parameters": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "Value": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          "Use": {
                            "type": "string",
                            "enum": [
                              "Everywhere",
                              "In Auth Request",
                              "In Token Request"
                            ],
                            "description": "Where the value is sent: both requests (default), only the browser authorization request, or only the token request."
                          }
                        },
                        "required": [
                          "Value"
                        ]
                      }
                    ]
                  }
                },
                "Custom Request Headers": {
                  "type": "object",
                  "additionalProperties": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      {
                        "type": "object",
                        "properties": {
                          "Value": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          "Use": {
                            "type": "string",
                            "enum": [
                              "Everywhere",
                              "In Auth Request",
                              "In Token Request"
                            ],
                            "description": "Where the value is sent: both requests (default), only the browser authorization request, or only the token request."
                          }
                        },
                        "required": [
                          "Value"
                        ]
                      }
                    ]
                  }
                },
                "Acquire Automatically": {
                  "type": "boolean",
                  "default": true,
                  "description": "false: requests only use a token acquired with \"Plainwire: Acquire OAuth 2 Token\"."
                },
                "Use ID Token": {
                  "type": "boolean",
                  "default": false,
                  "description": "$auth.token returns the ID token instead of the access token."
                },
                "Open Complete URI": {
                  "type": "boolean",
                  "default": false,
                  "description": "Device Authorization: open verification_uri_complete (the code is in the URL)."
                },
                "Token": {
                  "type": "string",
                  "description": "Mock: the access token to use."
                },
                "ID Token": {
                  "type": "string",
                  "description": "Mock: the ID token to use."
                }
              }
            }
          }
        }
      }
    },
    "additionalProperties": {
      "description": "A variable, used as {{name}}."
    }
  }
}
