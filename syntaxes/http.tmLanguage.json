{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HTTP (Plainwire)",
  "scopeName": "source.http.plainwire",
  "patterns": [
    {
      "include": "#separator"
    },
    {
      "include": "#wsSeparator"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#httpyacAssert"
    },
    {
      "include": "#script"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#fileVariable"
    },
    {
      "include": "#jetbrainsDirective"
    },
    {
      "include": "#requestLine"
    },
    {
      "include": "#query"
    },
    {
      "include": "#header"
    },
    {
      "include": "#jsonBody"
    },
    {
      "include": "#variable"
    }
  ],
  "repository": {
    "separator": {
      "match": "^###.*$",
      "name": "markup.heading.separator.http"
    },
    "wsSeparator": {
      "match": "^\\s*(===)(?:\\s+(wait-for-server))?\\s*(//.*)?$",
      "captures": {
        "1": {
          "name": "keyword.operator.separator.websocket.http"
        },
        "2": {
          "name": "keyword.control.wait.websocket.http"
        },
        "3": {
          "name": "comment.line.double-slash.http"
        }
      }
    },
    "jetbrainsDirective": {
      "match": "^\\s*(import|run)\\s+(\\S+\\.(?:http|rest)|#\\(?[^\\s)]+\\)?)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.import.http"
        },
        "2": {
          "name": "string.unquoted.path.http"
        },
        "3": {
          "name": "string.unquoted.metadata.http"
        }
      }
    },
    "httpyacAssert": {
      "match": "^\\s*(\\?\\?)\\s+(\\S+)(.*)$",
      "captures": {
        "1": {
          "name": "keyword.control.assert.http"
        },
        "2": {
          "name": "entity.name.tag.http"
        },
        "3": {
          "name": "string.unquoted.http"
        }
      }
    },
    "metadata": {
      "match": "^\\s*(#|//)\\s*(@[\\w-]+)(.*)$",
      "captures": {
        "1": {
          "name": "comment.line.http"
        },
        "2": {
          "name": "keyword.other.metadata.http"
        },
        "3": {
          "name": "string.unquoted.metadata.http"
        }
      }
    },
    "comment": {
      "match": "^\\s*(#|//).*$",
      "name": "comment.line.http"
    },
    "fileVariable": {
      "match": "^\\s*(@)([\\w.-]+)\\s*(=)\\s*(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.variable.http"
        },
        "2": {
          "name": "variable.other.http"
        },
        "3": {
          "name": "keyword.operator.assignment.http"
        },
        "4": {
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "match": ".+",
              "name": "string.unquoted.http"
            }
          ]
        }
      }
    },
    "requestLine": {
      "match": "^\\s*(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS|TRACE|CONNECT|WEBSOCKET|WS|GRAPHQL)\\s+(\\S.*?)(\\s+HTTP/[\\d.]+)?\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.method.http"
        },
        "2": {
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "match": "[^{]+|\\{",
              "name": "string.unquoted.url.http"
            }
          ]
        },
        "3": {
          "name": "constant.language.version.http"
        }
      }
    },
    "query": {
      "match": "^\\s*([?&])([^=\\s]+)(=)?(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.separator.query.http"
        },
        "2": {
          "name": "variable.parameter.query.http"
        },
        "3": {
          "name": "keyword.operator.http"
        },
        "4": {
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "match": ".+",
              "name": "string.unquoted.http"
            }
          ]
        }
      }
    },
    "header": {
      "match": "^([A-Za-z0-9!#$%&'*+.^_`|~-]+)(:)\\s?(.*)$",
      "captures": {
        "1": {
          "name": "entity.name.tag.header.http"
        },
        "2": {
          "name": "punctuation.separator.key-value.http"
        },
        "3": {
          "patterns": [
            {
              "include": "#variable"
            },
            {
              "match": ".+",
              "name": "string.unquoted.header.http"
            }
          ]
        }
      }
    },
    "jsonBody": {
      "begin": "^\\s*(?=[\\[{])",
      "end": "^(?=###)",
      "contentName": "meta.embedded.block.json",
      "patterns": [
        {
          "include": "#variable"
        },
        {
          "include": "source.json"
        }
      ]
    },
    "variable": {
      "match": "(\\{\\{)\\s*([^{}]+?)\\s*(\\}\\})",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.http"
        },
        "2": {
          "name": "variable.other.readwrite.http"
        },
        "3": {
          "name": "punctuation.definition.template-expression.end.http"
        }
      }
    },
    "script": {
      "patterns": [
        {
          "name": "meta.script.inline.http",
          "match": "^\\s*([<>])\\s+(\\{%)(.*)(%\\})\\s*$",
          "captures": {
            "1": {
              "name": "keyword.operator.script.http"
            },
            "2": {
              "name": "punctuation.section.embedded.begin.http"
            },
            "3": {
              "name": "meta.embedded.block.javascript",
              "patterns": [
                {
                  "include": "source.js"
                }
              ]
            },
            "4": {
              "name": "punctuation.section.embedded.end.http"
            }
          }
        },
        {
          "begin": "^\\s*([<>])\\s+(\\{%)\\s*$",
          "beginCaptures": {
            "1": {
              "name": "keyword.operator.script.http"
            },
            "2": {
              "name": "punctuation.section.embedded.begin.http"
            }
          },
          "end": "^\\s*(%\\})\\s*$",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.embedded.end.http"
            }
          },
          "contentName": "meta.embedded.block.javascript",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "match": "^\\s*([<>])\\s+([^\\s{%}]+\\.js)\\s*$",
          "captures": {
            "1": {
              "name": "keyword.operator.script.http"
            },
            "2": {
              "name": "string.unquoted.script-file.http"
            }
          }
        }
      ]
    }
  }
}
